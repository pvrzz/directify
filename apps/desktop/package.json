{
  "name": "@directify/desktop",
  "productName": "directify",
  "version": "1.0.0",
  "description": "A feature-rich, unofficial client for catboy.best. Seamlessly search, download, and manage your osu! beatmaps and beatpacks.",
  "author": "directify",
  "homepage": "https://github.com/pvrzz/directify",
  "repository": "github:pvrzz/directify",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:preview": "vite --config vite.preview.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "@directify/shared": "workspace:*",
    "@directify/ui": "workspace:*",
    "@fontsource/roboto": "^5.1.0",
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.11.0",
    "i18next": "^23.16.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^32.1.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
